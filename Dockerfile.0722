FROM reventon13713/project_f:test0718-fixed

USER root

COPY tools/requirements-ulog.txt /tmp/project_f-requirements-ulog.txt
COPY tools/requirements-qgc-mission.txt /tmp/project_f-requirements-qgc-mission.txt

RUN python3 -m pip install --no-cache-dir \
        -r /tmp/project_f-requirements-ulog.txt \
        -r /tmp/project_f-requirements-qgc-mission.txt \
    && rm -f \
        /tmp/project_f-requirements-ulog.txt \
        /tmp/project_f-requirements-qgc-mission.txt

ARG BAYLANDS_URL=http://models.gazebosim.org/baylands/model.tar.gz
ARG BAYLANDS_SHA256=18bce28a1ae89a146b57218653d773ed432d4bd381252ffb19102af98f7e952c
ENV PX4_GAZEBO_ROOT=/home/reventon/PX4-Autopilot/Tools/simulation/gazebo-classic/sitl_gazebo-classic

RUN set -eux; \
    archive=/tmp/project_f-baylands-model.tar.gz; \
    curl --fail --location --output "${archive}" "${BAYLANDS_URL}"; \
    printf '%s  %s\n' "${BAYLANDS_SHA256}" "${archive}" | sha256sum --check --status; \
    mkdir -p "${PX4_GAZEBO_ROOT}/models"; \
    tar -xzf "${archive}" -C "${PX4_GAZEBO_ROOT}/models" --wildcards \
        'baylands/model.config' \
        'baylands/media/baylands_01.DAE' \
        'baylands/media/baylands_02.DAE' \
        'baylands/media/baylands_03.DAE' \
        'baylands/media/scripts/*' \
        'baylands/media/Textures/*'; \
    rm -f "${archive}"

COPY src/VIO_pkg/gazebo_models/fpv_cam/ ${PX4_GAZEBO_ROOT}/models/fpv_cam/
COPY src/VIO_pkg/gazebo_models/iris_fpv_cam/ ${PX4_GAZEBO_ROOT}/models/iris_fpv_cam/
COPY src/VIO_pkg/gazebo_models/vio_baylands/ ${PX4_GAZEBO_ROOT}/models/vio_baylands/
COPY src/VIO_pkg/gazebo_models/vio_imu/ ${PX4_GAZEBO_ROOT}/models/vio_imu/
COPY src/VIO_pkg/gazebo_worlds/vio_baylands.world ${PX4_GAZEBO_ROOT}/worlds/vio_baylands.world

RUN test -f "${PX4_GAZEBO_ROOT}/models/baylands/media/baylands_01.DAE" \
    && test -f "${PX4_GAZEBO_ROOT}/models/vio_baylands/model.sdf" \
    && test -f "${PX4_GAZEBO_ROOT}/worlds/vio_baylands.world" \
    && chown -R reventon:reventon "${PX4_GAZEBO_ROOT}/models/baylands" \
        "${PX4_GAZEBO_ROOT}/models/fpv_cam" \
        "${PX4_GAZEBO_ROOT}/models/iris_fpv_cam" \
        "${PX4_GAZEBO_ROOT}/models/vio_baylands" \
        "${PX4_GAZEBO_ROOT}/models/vio_imu" \
        "${PX4_GAZEBO_ROOT}/worlds/vio_baylands.world"

WORKDIR /home/reventon
CMD ["/bin/bash"]
