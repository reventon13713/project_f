material VioLowRiseCity/TreeMaple
{
  technique
  {
    pass
    {
      ambient 0.78 0.78 0.78 1
      diffuse 0.94 0.94 0.94 1
      scene_blend alpha_blend
      alpha_rejection greater_equal 64
      depth_write off
      cull_hardware none
      cull_software none
      texture_unit { texture tree_maple.png filtering anisotropic max_anisotropy 8 }
    }
  }
}

