<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='vio_imu'>
    <link name='link'>
      <inertial>
        <mass>0.0001</mass>
        <inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia>
      </inertial>
      <sensor name='vio_imu_sensor' type='imu'>
        <always_on>true</always_on><update_rate>200</update_rate><visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x><noise type='gaussian'><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type='gaussian'><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type='gaussian'><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type='gaussian'><mean>0</mean><stddev>0.002</stddev></noise></x>
            <y><noise type='gaussian'><mean>0</mean><stddev>0.002</stddev></noise></y>
            <z><noise type='gaussian'><mean>0</mean><stddev>0.002</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name='vio_imu_plugin' filename='libgazebo_ros_imu_sensor.so'>
          <ros><namespace>/vio</namespace><remapping>~/out:=imu</remapping></ros>
          <frame_name>vio_imu_link</frame_name>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
      </sensor>
      <!-- Gazebo ray sensors look along +X.  +90 deg pitch rotates +X to -Z. -->
      <sensor name='vio_downward_lidar' type='ray'>
        <!-- Keep the ray origin outside the airframe collision mesh. -->
        <pose>0 0 -0.10 0 1.57079632679 0</pose>
        <always_on>true</always_on><update_rate>30</update_rate><visualize>true</visualize>
        <ray>
          <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.05</min><max>30.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name='vio_range_plugin' filename='libgazebo_ros_ray_sensor.so'>
          <ros><namespace>/vio</namespace><remapping>~/out:=range</remapping></ros>
          <output_type>sensor_msgs/Range</output_type>
          <frame_name>vio_lidar_link</frame_name>
          <radiation_type>infrared</radiation_type>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
