<?xml version="1.0"?>
<sdf version="1.5">
  <!--
    Keep all three public Baylands visual meshes and natural textures, but do
    not reuse the render scene as a triangle-mesh collision surface.  The
    upstream collision takes minutes to initialize in Gazebo Classic 11 and
    is unnecessary for the bounded aerial mission used by this project.
  -->
  <model name="vio_baylands">
    <pose>0 0 -1.3 0 0 0</pose>
    <static>true</static>

    <link name="scene">
      <visual name="vegetation_01">
        <geometry>
          <mesh><uri>model://baylands/media/baylands_01.DAE</uri></mesh>
        </geometry>
        <material>
          <script>
            <uri>model://baylands/media/scripts/</uri>
            <uri>model://baylands/media/Textures/</uri>
            <name>OakTree/Branch</name>
          </script>
        </material>
      </visual>

      <visual name="vegetation_02">
        <geometry>
          <mesh><uri>model://baylands/media/baylands_02.DAE</uri></mesh>
        </geometry>
        <material>
          <script>
            <uri>model://baylands/media/scripts/</uri>
            <uri>model://baylands/media/Textures/</uri>
            <name>OakTree/Branch</name>
          </script>
        </material>
      </visual>

      <visual name="terrain_and_structures_03">
        <geometry>
          <mesh><uri>model://baylands/media/baylands_03.DAE</uri></mesh>
        </geometry>
      </visual>

      <!-- Top surface is world z=0 after the model's -1.3 m pose offset. -->
      <collision name="mission_ground">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><box><size>500 500 0.2</size></box></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
