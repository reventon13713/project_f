<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='fpv_cam'>
    <pose>-0.158979 -0.04405 0.045074 0 0 0</pose>
    <link name='link'>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>4.15e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.407e-6</iyy><iyz>0</iyz><izz>2.407e-6</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <geometry><box><size>0.01 0.01 0.01</size></box></geometry>
